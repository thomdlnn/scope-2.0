# Copiez ce fichier en .env (jamais commité) et renseignez-le.

# Token GitHub fine-grained, en LECTURE SEULE sur les dépôts de vos projets
# (Contents: Read-only, Pull requests: Read-only).
SCOPE_GH_TOKEN=

# Tokens dédiés à un projet (optionnel) : clé `token:` de projects/<projet>.yml.
# SCOPE_TOKEN_BOUTIQUE=

# Port local de la page (http://localhost:8080) et intervalle de régénération (secondes).
SCOPE_PORT=8080
SCOPE_INTERVAL=900
